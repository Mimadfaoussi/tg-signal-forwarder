# ---- Telegram user account (used by BOTH services, each with its own session) ----
# TG_API_ID and TG_API_HASH come from https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# ---- Listener ----
# SOURCE_CHAT: -100xxxxxxxxxx or @username
SOURCE_CHAT=
CATCHUP_LIMIT=50

# ---- Publisher ----
# TARGET_CHAT: a group/supergroup/private chat your account can write in
# (-100xxxxxxxxxx or @username) -- NOT a broadcast channel you aren't an admin of.
TARGET_CHAT=
# TARGET_TOPIC_ID: optional forum topic id
TARGET_TOPIC_ID=
# OUTPUT_MODE: copy | template
OUTPUT_MODE=copy
# ACCOUNT_IS_PREMIUM: true keeps custom-emoji entities when sending
ACCOUNT_IS_PREMIUM=false
DRY_RUN=false
# Account-safety rate limiting (§6.7) -- seconds, seconds, count, seconds
MIN_SEND_INTERVAL=5
SEND_JITTER=2
MAX_SENDS_PER_HOUR=30
MAX_FLOOD_WAIT=3600

# ---- Filter ----
QUOTE_ASSETS=USDT

# ---- Infra ----
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=forwarder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forwarder
DATABASE_URL=postgresql://forwarder:change-me@postgres:5432/forwarder

# ---- Ops ----
LOG_LEVEL=INFO
TZ=Europe/Berlin
