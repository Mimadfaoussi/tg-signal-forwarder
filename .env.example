# ---- Telegram user account (used by BOTH services, each with its own session) ----
# TG_API_ID and TG_API_HASH come from https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# ---- Listener ----
# SOURCE_CHAT: -100xxxxxxxxxx or @username. Comma-separated for more than one
# source channel, e.g. SOURCE_CHAT=-100111,-100222,@somechannel
SOURCE_CHAT=
# CATCHUP_LIMIT applies per source channel
CATCHUP_LIMIT=50

# ---- Publisher ----
# TARGET_CHAT: a group/supergroup/private chat your account can write in
# (-100xxxxxxxxxx or @username) -- NOT a broadcast channel you aren't an admin of.
TARGET_CHAT=
# TARGET_TOPIC_ID: optional forum topic id
TARGET_TOPIC_ID=
# OUTPUT_MODE: copy (real Telegram forward of the source message) | template
# (composes a new message from the parsed fields via signal.txt.j2)
OUTPUT_MODE=copy
DRY_RUN=false
# Account-safety rate limiting (§6.7) -- seconds, seconds, count, seconds
MIN_SEND_INTERVAL=5
SEND_JITTER=2
MAX_SENDS_PER_HOUR=30
MAX_FLOOD_WAIT=3600
# Trade-volume limits, independent of the rate limiting above -- 0 disables
# either one. MAX_TRADES_PER_DAY resets at midnight in TZ (below).
# PAIR_COOLDOWN_HOURS blocks re-forwarding the same pair for this many hours
# after it was last forwarded, even if that earlier trade already closed.
MAX_TRADES_PER_DAY=12
PAIR_COOLDOWN_HOURS=24
# Caps how many trades can be open at once, tracked from the execution bot's
# own status messages in TARGET_CHAT (fills, TP/SL hits, cancellations,
# failures) -- not just a guess. 0 disables.
MAX_CONCURRENT_TRADES=8

# ---- Filter ----
QUOTE_ASSETS=USDT

# ---- Infra ----
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=forwarder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forwarder
DATABASE_URL=postgresql://forwarder:change-me@postgres:5432/forwarder

# ---- Ops ----
LOG_LEVEL=INFO
TZ=Europe/Berlin
